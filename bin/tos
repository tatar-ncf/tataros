#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════
#  TOS — TatarOS Linux идарә коралы / control tool (talosctl кабыгы)
#  Милли Talos. Татарча әмерләр talosctl'га тәрҗемә ителә.
#  МӨҺИМ: TatarOS кластерга КУБЕРНЕТЕС түгел, ТАТАРНЕТЕС бирә!
#  TatarOS boots TATARNETES, not vanilla Kubernetes.
#
#  © Бөек татар халкына / to the great Tatar people — Tatarch License 2.0
# ═══════════════════════════════════════════════════════════════════════
set -uo pipefail

# TOS_* → AYDA_* күпер (уртак кscript'лар AYDA_* куллана) / env bridge.
: "${AYDA_NO_TEA:=${TOS_NO_TEA:-}}";     export AYDA_NO_TEA
: "${AYDA_PLAIN:=${TOS_PLAIN:-}}";       export AYDA_PLAIN
: "${AYDA_QUIET:=${TOS_QUIET:-}}";       export AYDA_QUIET
: "${AYDA_FORCE_FUN:=${TOS_FORCE_FUN:-}}"; export AYDA_FORCE_FUN
: "${AYDA_FORCE_TEA:=${TOS_FORCE_TEA:-}}"; export AYDA_FORCE_TEA
: "${AYDA_LANG:=${TOS_LANG:-tt}}";          export AYDA_LANG
: "${AYDA_ALIF:=${TOS_ALIF:-cyrl}}";        export AYDA_ALIF

TOS_HOME="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"
LIB="$TOS_HOME/lib"
for _m in render alif catalog i18n dictionary faces phrases teatime calendar errors; do
  # shellcheck source=/dev/null
  . "$LIB/$_m.sh"
done

TALOSCTL_BIN="${TOS_TALOSCTL:-talosctl}"
TOS_VERSION="2.0.0"

_help_tt() {
  cat <<HLP | alif_render
  TOS — TatarOS Linux идарә коралы  v${TOS_VERSION}
  Милли Talos. Кластерга ТАТАРНЕТЕС бирә.

  КУЛЛАНУ:
    tos <фигыль> [асыл] [флаглар]

  МИСАЛЛАР:
    tos сәламәтлек                    → talosctl health
    tos татарнетес-конфиг             → talosctl kubeconfig   (Татарнетес!)
    tos күрсәт төеннәр                → talosctl get nodes
    tos kürsät töennär               → латинча да языла
    tos яңадан-кабыз -n 10.0.0.5      → talosctl reboot -n 10.0.0.5

  ЭЧКЕ ӘМЕРЛӘР:
    tos ярдәм · сүзлек · версия · шигырь · мәкаль · чәй · сәлам

  КӨЙЛӘМӘЛӘР (ENV):
    TOS_LANG=tt|en · TOS_ALIF=cyrl|latin|arab
    TOS_TALOSCTL=<юл> · TOS_NO_TEA=1 · TOS_FORCE_TEA=1 · TOS_PLAIN=1
HLP
}
_help_en() {
  cat <<HLP
  tos — TatarOS Linux control tool  v${TOS_VERSION}
  A national Talos that provisions Tatarnetes.

  USAGE:
    tos <verb> [resource] [flags]

  EXAMPLES:
    tos сәламәтлек                    → talosctl health
    tos татарнетес-конфиг             → talosctl kubeconfig (yields Tatarnetes!)
    tos kürsät töennär               → talosctl get nodes (Latin input)
    tos get nodes                     → plain talosctl works too

  BUILT-INS: tos ярдәм|help · сүзлек · версия · шигырь · мәкаль · чәй · сәлам
  ENV: TOS_LANG=tt|en · TOS_ALIF=cyrl|latin|arab · TOS_TALOSCTL · TOS_NO_TEA
       TOS_FORCE_TEA · TOS_PLAIN
HLP
}
show_help() { if [ "$AYDA_LANG" = "en" ]; then _help_en >&2; else _help_tt >&2; fi }

show_version() {
  tat_carpet
  tat_bold "  TatarOS Linux  v${TOS_VERSION}"
  printf '%b\n' "  ${TAT_GREEN}$(t tos.version.tagline)${TAT_RESET}" >&2
  printf '%b\n' "  ${TAT_DIM}$(t version.dedication)${TAT_RESET}" >&2
  if command -v "$TALOSCTL_BIN" >/dev/null 2>&1; then
    "$TALOSCTL_BIN" version --client 2>/dev/null | sed 's/^/    /' >&2 || true
  fi
  tat_carpet
}

show_tea_break() {
  local left; left=$(tea_minutes_left)
  {
    tat_carpet; tat_face_tea
    printf '%b\n' "${TAT_GOLD}${TAT_BOLD}  ⛔ $(t tea.title) ⛔${TAT_RESET}"
    printf '%s\n' "  $(t tos.tea.body) 🍵🫓"
    printf '%s\n' "  $(t tea.retry "$left")"
    tat_carpet
  } >&2
}

print_poem()    { tat_carpet; printf '%b\n' "${TAT_GOLD}$(tat_random_poem)${TAT_RESET}" >&2; tat_carpet; }
print_proverb() { tat_carpet; printf '%b\n' "${TAT_GOLD}$(tat_random_proverb)${TAT_RESET}" >&2; tat_carpet; }
greet() {
  tat_carpet; tat_face_happy
  printf '%b\n' "  ${TAT_GREEN}${TAT_BOLD}$(t tos.greet.hello)${TAT_RESET}" >&2
  printf '%b\n' "  ${TAT_DIM}$(t tos.greet.sub)${TAT_RESET}" >&2
  local fest; fest="$(tat_festival)" || fest=""
  [ -n "$fest" ] && printf '%b\n' "  ${TAT_GOLD}${TAT_BOLD}$(t "$fest")${TAT_RESET}" >&2
  tat_carpet
}
tea_status() {
  tat_carpet
  if tea_now; then tat_face_tea; printf '%b\n' "  ${TAT_GOLD}$(t tea.now "$(tea_minutes_left)")${TAT_RESET}" >&2
  else printf '%b\n' "  ${TAT_GREEN}$(t tea.working "$(tea_next_hhmm)")${TAT_RESET}" >&2; fi
  tat_carpet
}

main() {
  [ "$#" -eq 0 ] && { show_help; exit 0; }
  local verb="$1"; shift
  case "$verb" in
    ярдәм|help|--help|-h)       show_help;    exit 0 ;;
    версия|version|--version)   show_version; exit 0 ;;
    сүзлек|dictionary)          show_dictionary | alif_render >&2; exit 0 ;;
    шигырь|тукай|tukay|poem)    print_poem;   exit 0 ;;
    мәкаль|мәкальләр|proverb)   print_proverb; exit 0 ;;
    чәй|tea)                    tea_status;   exit 0 ;;
    сәлам|salam|исәнме|hi)      greet;        exit 0 ;;
  esac

  if tea_now; then show_tea_break; exit 42; fi

  local kverb; kverb="$(resolve_verb "$verb")"    # латин фолбэк / Latin input
  if [ -z "$kverb" ]; then
    { tat_carpet; tat_face_angry
      printf '%b\n' "  ${TAT_RED}${TAT_BOLD}$(t err.unknown_verb "$verb")${TAT_RESET}"
      printf '%b\n' "  ${TAT_RED}$(tat_random_curse)${TAT_RESET}"
      printf '%b\n' "  $(t tos.hint.try_help)"
      tat_carpet; } >&2
    exit 64
  fi

  # Бары тик беренче позицион сүзне тәрҗемә (асыл төре); исем/флаг кыйммәте —
  # үзгәрешсез. Only the first positional token (resource type) is translated.
  local -a kargs=()
  local tok res_done=0
  for tok in "$@"; do
    case "$tok" in
      -*) kargs+=("$tok") ;;
      *)  if [ "$res_done" -eq 0 ]; then
            kargs+=("$(resolve_noun "$tok")"); res_done=1
          else
            kargs+=("$tok")
          fi ;;
    esac
  done

  tat_dim "🐧 → $TALOSCTL_BIN $kverb ${kargs[*]:-}"

  if ! command -v "$TALOSCTL_BIN" >/dev/null 2>&1; then
    { tat_carpet; tat_face_angry
      printf '%b\n' "  ${TAT_RED}$(t tos.talosctl.notfound "$TALOSCTL_BIN")${TAT_RESET}"
      printf '%s\n' "  $(t tos.talosctl.notfound.hint)"
      tat_carpet; } >&2
    exit 127
  fi

  "$TALOSCTL_BIN" "$kverb" ${kargs[@]+"${kargs[@]}"}
  local rc=$?

  if [ "$rc" -eq 0 ]; then
    tat_fun_enabled && { tat_carpet; tat_face_happy
      printf '%b\n' "  ${TAT_GREEN}${TAT_BOLD}$(tat_random_praise)${TAT_RESET}" >&2
      printf '%b\n' "${TAT_GOLD}$(tat_random_garnish)${TAT_RESET}" >&2
      local fest; fest="$(tat_festival)" || fest=""
      [ -n "$fest" ] && printf '%b\n' "  ${TAT_GOLD}${TAT_BOLD}$(t "$fest")${TAT_RESET}" >&2
      tat_carpet; }
  else
    tat_fun_enabled && { tat_carpet; tat_face_angry
      printf '%b\n' "  ${TAT_RED}${TAT_BOLD}$(tat_random_curse)${TAT_RESET}  ${TAT_DIM}$(t err.code "$rc")${TAT_RESET}" >&2
      tat_carpet; }
  fi
  exit "$rc"
}

main "$@"
